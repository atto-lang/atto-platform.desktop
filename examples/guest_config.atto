// AttoLang canonical .atto native LLVM desktop scalar linkage fixture.
// The host owns lifecycle/UI; these exports only configure a headless window.
pub fnc desktop_initial_width(): int {
    return 800;
}
pub fnc desktop_initial_height(): int {
    return 500;
}
fnc desktop_unreachable_probe(): int {
    return 999;
}
